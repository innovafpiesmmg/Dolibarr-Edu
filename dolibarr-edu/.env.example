# ─────────────────────────────────────────────────────────────────────────────
#  ERP EDU — Variables de entorno
#  El instalador genera este fichero automáticamente con contraseñas seguras.
#  NO compartas este fichero ni lo subas a un repositorio público.
# ─────────────────────────────────────────────────────────────────────────────

# ── Dolibarr por alumno (orquestado por el panel) ────────────────────────────
# Dominio base — cada alumno tendrá su Dolibarr en https://<usuario>.<BASE_DOMAIN>/
BASE_DOMAIN=erp.micentro.es
# Imagen Docker que se usará para crear cada Dolibarr de alumno
DOLIBARR_IMAGE=dolibarr/dolibarr:latest
# Módulos activados por defecto al crear un Dolibarr de alumno
DOLIBARR_MODULES=modApi,modSociete,modFournisseur,modFacture,modProjet,modStock,modBanque,modContrat,modComptabilite,modHrm
# Red Docker en la que se conectarán los contenedores de alumno (la del compose)
STUDENT_DOCKER_NETWORK=dolibarr-edu_dolibarr_net

# ── MariaDB compartida (una BD por alumno) ───────────────────────────────────
MYSQL_ROOT_PASSWORD=cambia_esta_contrasena_root
# Puerto local de Traefik (proxy reverso *.{BASE_DOMAIN})
TRAEFIK_PORT=8090

# ── Panel de Gestión (Node.js + React) ───────────────────────────────────────
PANEL_URL=https://panel.micentro.es
PANEL_DB_PASSWORD=cambia_esta_contrasena_panel
# Contraseña del panel — hash SHA-256 generado por el instalador
ADMIN_PASSWORD_HASH=
# Clave de sesión Express
SESSION_SECRET=cambia_esta_clave_sesion
# Puerto local del panel web
PANEL_PORT=8068

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Token del túnel (Dashboard → Zero Trust → Networks → Tunnels → tu túnel → Configure → Overview)
# Public Hostnames necesarios:
#   panel.{tu-dominio}   → http://panel_web:80   (panel + landing)
#   *.{BASE_DOMAIN}      → http://traefik:80     (Dolibarr de cada alumno)
COMPOSE_PROFILES=
CLOUDFLARE_TOKEN=
