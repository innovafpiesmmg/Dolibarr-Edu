# ─────────────────────────────────────────────────────────────────────────────
#  ERP EDU — Variables de entorno
#  El instalador genera este fichero automáticamente con contraseñas seguras.
#  NO compartas este fichero ni lo subas a un repositorio público.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos Dolibarr (MariaDB) ─────────────────────────────────────────
MYSQL_ROOT_PASSWORD=cambia_esta_contrasena_root
MYSQL_DATABASE=dolibarr
MYSQL_USER=dolibarr
MYSQL_PASSWORD=cambia_esta_contrasena_db

# ── Dolibarr ERP ──────────────────────────────────────────────────────────────
# URL pública de Dolibarr (la del túnel Cloudflare)
DOLI_URL_ROOT=https://erp.micentro.es
DOLI_DOMAIN=erp.micentro.es

# Cuenta de superadministrador (solo para instalación inicial)
DOLI_ADMIN_LOGIN=admin
DOLI_ADMIN_PASSWORD=cambia_esta_contrasena_admin
DOLI_ADMIN_EMAIL=admin@micentro.es

# Nombre del centro educativo
DOLI_COMPANY_NAME=Centro FP Administración de Empresas

# Puerto local de Dolibarr (solo accesible desde Cloudflare)
APP_PORT=8069

# ── OpenProject — Gestión de proyectos ───────────────────────────────────────
OP_HOST=proyectos.micentro.es
OP_DB_PASSWORD=cambia_esta_contrasena_openproject
OP_SECRET_KEY=cambia_esta_clave_secreta_openproject
OP_PORT=8070

# ── Collabora Online — LibreOffice en el navegador ───────────────────────────
COLLABORA_ADMIN=admin
COLLABORA_PASSWORD=cambia_esta_contrasena_collabora
COLLABORA_PORT=9980
# Dominio público de Collabora (usado en aliasgroup1 de la imagen)
OFFICE_HOST=office.micentro.es

# ── Nextcloud — Almacenamiento en la nube (opcional) ─────────────────────────
# Para activar Nextcloud: pon COMPOSE_PROFILES=nextcloud y rellena NC_HOST.
# Para desactivarlo: deja COMPOSE_PROFILES en blanco o elimina la línea.
COMPOSE_PROFILES=

# Dominio público de Nextcloud (sin https://)
NC_HOST=
# Puerto local de Nextcloud
NC_PORT=8071
# Base de datos de Nextcloud (MariaDB)
NC_DB_ROOT_PASSWORD=cambia_esta_contrasena_nc_root
NC_DB_PASSWORD=cambia_esta_contrasena_nc_db
# Cuenta de administrador de Nextcloud
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=cambia_esta_contrasena_nc_admin
# URL interna de Nextcloud (para el panel API — no cambiar)
NEXTCLOUD_URL=http://nextcloud:80

# ── Panel de Gestión (Node.js + React) ───────────────────────────────────────
# URL pública del panel
PANEL_URL=https://panel.micentro.es

# Base de datos exclusiva del panel (PostgreSQL)
PANEL_DB_PASSWORD=cambia_esta_contrasena_panel

# URL pública de Dolibarr (usada por el panel para llamar a la API de Dolibarr)
DOLIBARR_BASE_URL=https://erp.micentro.es

# Contraseña del panel — hash SHA-256 generado por el instalador
ADMIN_PASSWORD_HASH=

# Clave de sesión Express
SESSION_SECRET=cambia_esta_clave_sesion

# Puerto local del panel web
PANEL_PORT=8068

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Token del túnel (Dashboard → Zero Trust → Networks → Tunnels → tu túnel → Configure → Overview)
CLOUDFLARE_TOKEN=
