FROM node:24-alpine AS builder
WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@latest --activate

# Workspace config
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig*.json ./

# Libs compartidas
COPY lib/ ./lib/

# API server
COPY artifacts/api-server/ ./artifacts/api-server/

# Instalar dependencias (--ignore-scripts omite el check de agente del workspace raíz)
RUN pnpm install --frozen-lockfile --ignore-scripts

# Compilar libs (tipos necesarios para esbuild)
RUN pnpm run typecheck:libs

# Build del API server
RUN pnpm --filter @workspace/api-server run build

# ── Imagen de producción (API server) ────────────────────────────────────────
FROM node:24-alpine AS api
WORKDIR /app

COPY --from=builder /workspace/artifacts/api-server/dist ./dist

ENV NODE_ENV=production
ENV PORT=8080
ENV BASE_PATH=/api

CMD ["node", "--enable-source-maps", "./dist/index.mjs"]

# ── Imagen del migrador (aplica schema a la BD del panel) ─────────────────────
FROM node:24-alpine AS migrator
WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY --from=builder /workspace/package.json /workspace/pnpm-lock.yaml /workspace/pnpm-workspace.yaml ./
COPY --from=builder /workspace/tsconfig*.json ./
COPY --from=builder /workspace/lib/ ./lib/

RUN pnpm install --frozen-lockfile --ignore-scripts

CMD ["pnpm", "--filter", "@workspace/db", "run", "push"]
