# Imagen Dolibarr con MultiCompany integrado (fork hregis).
#
# El módulo MultiCompany no está disponible como zip descargable libre ni como
# repo clonable independiente — solo existe como parches integrados en el fork
# hregis/dolibarr_multicompany (https://github.com/hregis/dolibarr_multicompany).
#
# Por eso construimos nuestra propia imagen: partimos de la imagen oficial
# (para heredar el entrypoint, PHP, Apache, init de BD, etc.) y sustituimos
# el árbol htdocs por el del fork con MultiCompany ya integrado.
FROM dolibarr/dolibarr:21

ARG MC_BRANCH=21.0-mc
# CACHE_BUST cambia en cada build sin caché y fuerza re-clonado del fork
# (sin esto, Docker reutiliza la capa del git clone aunque hregis publique
# correcciones nuevas). update.sh pasa --build-arg CACHE_BUST=$(date +%s).
ARG CACHE_BUST=1

USER root

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends git ca-certificates; \
    rm -rf /var/lib/apt/lists/*; \
    echo "CACHE_BUST=${CACHE_BUST}"; \
    git clone --depth=1 --branch "${MC_BRANCH}" \
      https://github.com/hregis/dolibarr_multicompany.git /tmp/hregis; \
    # Conservar install.forced.php si la imagen oficial lo aporta (preconfiguración).
    [ -f /var/www/html/install/install.forced.php ] \
      && cp /var/www/html/install/install.forced.php /tmp/install.forced.php \
      || true; \
    # Sustituir htdocs por el del fork (incluye MultiCompany integrado en core).
    rm -rf /var/www/html/*; \
    find /var/www/html -maxdepth 1 -name '.*' ! -name '.' ! -name '..' -exec rm -rf {} +; \
    cp -a /tmp/hregis/htdocs/. /var/www/html/; \
    [ -f /tmp/install.forced.php ] \
      && cp /tmp/install.forced.php /var/www/html/install/install.forced.php \
      || true; \
    chown -R www-data:www-data /var/www/html; \
    rm -rf /tmp/hregis /tmp/install.forced.php; \
    apt-get purge -y git; \
    apt-get autoremove -y; \
    apt-get clean
